DRIVEOPS_SCOPE_PROFILE=readonly
DRIVEOPS_GOOGLE_CLIENT_SECRET=/home/you/.config/driveops-mcp/client_secret.json
DRIVEOPS_GOOGLE_TOKEN=/home/you/.config/driveops-mcp/token.json
DRIVEOPS_STATE_DIR=/home/you/.local/share/driveops-mcp

# Public single-owner deployment. Inject secret values through your host's secret
# manager; do not commit them here. Use either oauth or token mode.
DRIVEOPS_PUBLIC_URL=https://mcp.example.com
DRIVEOPS_MCP_AUTH_MODE=oauth
# Optional for hosted deployments; generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DRIVEOPS_PLAN_ENCRYPTION_KEY=replace-with-generated-fernet-key
DRIVEOPS_OAUTH_ACCESS_KEY=replace-with-at-least-32-random-bytes
DRIVEOPS_OAUTH_ALLOWED_REDIRECT_URIS=https://client.example/oauth/callback
# DRIVEOPS_GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"..."}

# Static bearer mode for clients that can set an Authorization header:
# DRIVEOPS_MCP_AUTH_MODE=token
# DRIVEOPS_MCP_AUTH_TOKEN=replace-with-at-least-32-random-bytes

# Defense-in-depth limits (per process).
DRIVEOPS_MAX_REQUEST_BYTES=2000000
DRIVEOPS_RATE_LIMIT_REQUESTS=120
